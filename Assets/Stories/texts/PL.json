		 }
		 ,
		 {
		   "key": "The OG Kitty who inspired the Kitty Kitty series and the very Liquid Darkness existance.",
		   "value": "Ten pierwszy Kitty, od którego wzięła się cała seria Kitty Kitty i samo istnienie Liquid Darkness."
		 }
		 ,
		 {
		   "key": "A free spirit who bound their life with their human. Quick on her feet, nimble and flexy.",
		   "value": "Wolny duch, który związał swoje życie z człowiekiem. Szybka na łapach, zwinna i gibka."
		 }
		 ,
		 {
		   "key": "Big boy fluff, nice and soft, but not very bright. It's important to look after him closely.",
		   "value": "Wielki kłąb futra, miękki i miły, ale niezbyt bystry. Trzeba mieć go na oku."
		 }
		 ,
		 {
		   "key": "Starting a new game resets any progress you've made so far. Are you sure you want to proceed?",
		   "value": "Nowa gra kasuje cały dotychczasowy postęp. Na pewno chcesz to zrobić?"
		 }
		 ,
		 {
		   "key": "- available in the full version after finishing any scenario on 'Hard',\n- it really is hard-hard",
		   "value": "- dostępny w pełnej wersji po ukończeniu dowolnego scenariusza na 'Trudnym',\n- naprawdę jest trudno-trudno"
		 }
		 ,
		 {
		   "key": "- best for the first-time play,\n- slower game speed,\n- more desireable drops\n- drops very few achievements",
		   "value": "- najlepszy na pierwsze podejście,\n- wolniejsze tempo gry,\n- częstsze przydatne bonusy\n- prawie nie daje osiągnięć"
		 }
		 ,
		 {
		   "key": "Two fluffy siblings on an adventure of their lives! They can only ever be seen apart is when it's litter tray time.",
		   "value": "Dwoje puchatego rodzeństwa na przygodzie życia! Rozdzielają się tylko wtedy, gdy przychodzi pora na kuwetę."
		 }
		 ,
		 {
		   "key": "- regular game speed\n- balanced drop chance\n- unlocks higher level of difficulty for all scenarios if you finish one on it",
		   "value": "- normalne tempo gry\n- wyważona szansa na bonusy\n- ukończenie dowolnego scenariusza odblokowuje wyższy poziom trudności we wszystkich"
		 }
		 ,
		 {
